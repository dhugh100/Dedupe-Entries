# Ignore everything by default
*

# Allow directories (required so Git can search them for files)
!*/

# Whitelist C source and header files
!*.c
!*.h

# Whitelist build and configuration files
!.gitignore
!README.md
!*.conf

# Shell scripts
!*.sh

# Packaging assets needed to build the RPM from a clone
!dedupee.desktop
!dedupee.spec
!dedupee.png
!logo.xml
!io.github.dhugh100.Dedupee.png
!LICENSE

# GitHub Actions workflows
!*.yml
